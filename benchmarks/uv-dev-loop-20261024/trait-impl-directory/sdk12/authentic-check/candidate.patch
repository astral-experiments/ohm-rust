index 0000000000000000000000000000000000000000..b86a055fe7b87aecf33dccec05ed801348bcbd73
--- /dev/null
+++ b/tests/run-make/trait-impl-directory/consumer.rs
@@ -0,0 +1,31 @@
+#![allow(dead_code)]
+
+extern crate contracts;
+extern crate impls;
+
+struct Probe<T>(T);
+
+trait ProbeValue {
+    fn probe(self) -> u8;
+}
+
+impl<T> ProbeValue for &Probe<T> {
+    fn probe(self) -> u8 {
+        0
+    }
+}
+
+impl<T: contracts::Value> ProbeValue for Probe<T> {
+    fn probe(self) -> u8 {
+        contracts::Value::value(&self.0)
+    }
+}
+
+pub fn values() -> (u8, u8) {
+    (Probe(impls::Item).probe(), Probe(impls::Extra).probe())
+}
+
+fn main() {
+    let (item, extra) = values();
+    println!("{item} {extra}");
+}
