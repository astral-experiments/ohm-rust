diff --git a/compiler/rustc_session/src/config/target_cfg_values.rs b/compiler/rustc_session/src/config/target_cfg_values.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c6e5473241a0009ce80a36b5db3d13d615de4887
--- /dev/null
+++ b/compiler/rustc_session/src/config/target_cfg_values.rs
@@ -0,0 +1,162 @@
+#[path = "builtin_target_cfg_values.rs"]
+mod builtin;
+
+use std::borrow::Cow;
+
+use rustc_span::{Symbol, sym};
+use rustc_target::spec::Target;
+
+use super::ExpectedValues;
+
+fn fields(
+    target: &Target,
+    mut scalar: impl FnMut(usize, Symbol),
+    families: impl FnOnce(&[Cow<'static, str>]),
+) {
+    scalar(0, target.options.cfg_abi.desc_symbol());
+    scalar(1, target.arch.desc_symbol());
+    scalar(2, target.options.endian.desc_symbol());
+    scalar(3, target.options.env.desc_symbol());
+    families(&target.options.families);
+    scalar(4, target.options.binary_format.desc_symbol());
+    scalar(5, target.options.os.desc_symbol());
+    scalar(6, sym::integer(target.pointer_width));
+    scalar(7, target.vendor_symbol());
+}
+
+fn native_table() -> bool {
+    let native = Some("x86_64-unknown-linux-gnu");
+    cfg!(all(target_arch = "x86_64", target_os = "linux", target_env = "gnu"))
+        && option_env!("CFG_COMPILER_BUILD_TRIPLE") == native
+        && option_env!("CFG_COMPILER_HOST_TRIPLE") == native
+}
+
+pub(super) fn fill(values: [&mut ExpectedValues<Symbol>; 9], current: &Target) {
+    let [abi, arch, endian, env, family, format, os, width, vendor] = values;
+    let mut scalars = [abi, arch, endian, env, format, os, width, vendor];
+    let use_table = native_table();
+    if use_table {
+        let mut symbols = [None; builtin::VALUES.len()];
+        let mut intern = |id: u16| {
+            let index = usize::from(id);
+            *symbols[index].get_or_insert_with(|| Symbol::intern(builtin::VALUES[index]))
+        };
+        for row in builtin::TARGETS {
+            for (bucket, &value) in scalars[..4].iter_mut().zip(&row[..4]) {
+                bucket.insert(intern(value));
+            }
+            family.extend(builtin::FAMILIES[usize::from(row[4])].iter().map(|&id| intern(id)));
+            for (bucket, &value) in scalars[4..].iter_mut().zip(&row[5..]) {
+                bucket.insert(intern(value));
+            }
+        }
+    }
+
+    let mut add = |target: &Target| {
+        fields(
+            target,
+            |id, value| {
+                scalars[id].insert(value);
+            },
+            |names| family.extend(names.iter().map(|name| Symbol::intern(name))),
+        );
+    };
+    if !use_table {
+        for target in Target::builtins() {
+            add(&target);
+        }
+    }
+    add(current);
+}
+
+#[cfg(all(test, target_arch = "x86_64", target_os = "linux", target_env = "gnu"))]
+mod tests {
+    use std::fmt::Write as _;
+    use std::path::Path;
+
+    use super::*;
+
+    fn index<T: Eq>(values: &mut Vec<T>, value: T) -> u16 {
+        let index = values.iter().position(|old| *old == value).unwrap_or_else(|| {
+            values.push(value);
+            values.len() - 1
+        });
+        u16::try_from(index).unwrap()
+    }
+
+    #[test]
+    fn builtin_target_values() {
+        rustc_data_structures::sync::set_dyn_thread_safe_mode(true);
+        rustc_span::create_default_session_globals_then(|| {
+            let mut strings = Vec::new();
+            let mut families = Vec::new();
+            let mut targets = String::new();
+
+            for t in Target::builtins() {
+                let mut scalars = [None; 8];
+                let mut group = Vec::new();
+                fields(&t, |kind, value| scalars[kind] = Some(value), |names| {
+                    group.extend(names.iter().map(|s| s.to_string()));
+                });
+                let [abi, arch, endian, env, format, os, width, vendor] =
+                    scalars.map(|s| index(&mut strings, s.unwrap().as_str().to_owned()));
+                let group = group.into_iter().map(|s| index(&mut strings, s)).collect::<Vec<_>>();
+                let family = index(&mut families, group);
+                let row = [abi, arch, endian, env, family, format, os, width, vendor];
+                writeln!(targets, "    {row:?},").unwrap();
+            }
+
+            let mut source = String::from(concat!(
+                "// @generated by target_cfg_values::tests::builtin_target_values.\n",
+                "pub(super) const VALUES: &[&str] = &[\n",
+            ));
+            for value in strings {
+                writeln!(source, "    {value:?},").unwrap();
+            }
+            source.push_str("];\n\n#[rustfmt::skip]\npub(super) const FAMILIES: &[&[u16]] = &[\n");
+            for family in families {
+                writeln!(source, "    &{family:?},").unwrap();
+            }
+            source.push_str("];\n\n#[rustfmt::skip]\npub(super) const TARGETS: &[[u16; 9]] = &[\n");
+            source.push_str(&targets);
+            source.push_str("];\n");
+
+            if std::env::var_os("RUSTC_BLESS").is_some_and(|value| value != "0") {
+                assert!(native_table(), "regenerate on native x86_64 GNU/Linux");
+                let path = Path::new(env!("CARGO_MANIFEST_DIR"))
+                    .join("src/config/builtin_target_cfg_values.rs");
+                std::fs::write(path, source).unwrap();
+            } else {
+                assert_eq!(
+                    include_str!("builtin_target_cfg_values.rs"),
+                    source,
+                    "run ./x test compiler/rustc_session --bless on native x86_64 GNU/Linux"
+                );
+            }
+        });
+    }
+
+    #[test]
+    fn builtin_target_values_preserve_family_buckets() {
+        use rustc_data_structures::fx::FxHashSet;
+
+        rustc_data_structures::sync::set_dyn_thread_safe_mode(true);
+        rustc_span::create_default_session_globals_then(|| {
+            let current = Target::builtins().find(|t| t.options.families.is_empty()).unwrap();
+            for count in [0, 4] {
+                let user: FxHashSet<_> =
+                    (0..count).map(|n| Some(Symbol::intern(&format!("user-{n}")))).collect();
+                let mut expected = user.clone();
+                for target in Target::builtins().chain(std::iter::once(current.clone())) {
+                    expected.extend(target.options.families.iter().map(|s| Some(Symbol::intern(s))));
+                }
+                let mut actual = std::array::from_fn(|_| ExpectedValues::Any);
+                actual[4] = ExpectedValues::Some(user);
+                fill(actual.each_mut(), &current);
+                let ExpectedValues::Some(values) = &actual[4] else { unreachable!() };
+                assert_eq!(values.capacity(), expected.capacity());
+                assert!(values.iter().eq(expected.iter()));
+            }
+        });
+    }
+}
